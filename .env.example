# Copy to .env and fill in real values. Never commit .env.

# ---- MySQL ----
DB_NAME=ecommerce_db
DB_USERNAME=ecommerce_app
DB_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# ---- Security ----
# Bootstrap administrator created on first start
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@your-shop.com
ADMIN_PASSWORD=Change-Me-Admin@123
# true once the site is served over HTTPS (behind a reverse proxy); false for plain http://localhost
SESSION_COOKIE_SECURE=false

# ---- Store ----
# Time zone used for order timestamps and the date part of order numbers
APP_TIMEZONE=Asia/Phnom_Penh
SHOP_CURRENCY=USD
SHOP_SHIPPING_FEE=2.00
# Orders with a subtotal at or above this ship for free (0 = never free)
SHOP_FREE_SHIPPING_THRESHOLD=50.00

# ---- Web ----
# Public address of this site's reset page; the link sent to users is <url>?token=...
PASSWORD_RESET_URL=http://localhost:8080/reset-password
