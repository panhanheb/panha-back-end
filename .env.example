# Copy to .env and fill in real values. Never commit .env.

# ---- MySQL ----
DB_NAME=school_attendance_db
DB_USERNAME=attendance_app
DB_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# ---- Security ----
# Base64 key of at least 256 bits. Generate with:  openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_OUTPUT_OF_openssl_rand_-base64_64
JWT_ACCESS_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=7

# Bootstrap administrator created on first start
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@your-school.edu
ADMIN_PASSWORD=Change-Me-Admin@123

# ---- Time zone of the school (defines "today" for attendance) ----
APP_TIMEZONE=Asia/Phnom_Penh

# ---- Web ----
CORS_ALLOWED_ORIGINS=https://attendance.your-school.edu
PASSWORD_RESET_URL=https://attendance.your-school.edu/reset-password
SWAGGER_ENABLED=false
