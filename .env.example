# Copy to .env and change the values. Never commit .env.
# docker-compose.yml has local defaults for everything, so .env is only required for real deployments.

# ---- PostgreSQL ----
DB_NAME=ecommerce_db
DB_USERNAME=ecommerce
DB_PASSWORD=change-me-db-password

# ---- Redis ----
REDIS_PASSWORD=change-me-redis-password

# ---- Object storage (S3 API) ----
S3_BUCKET=ecommerce-media
S3_REGION=us-east-1
S3_ACCESS_KEY=ecommerce
S3_SECRET_KEY=change-me-storage-secret
# Address clients use to load images
S3_PUBLIC_BASE_URL=http://localhost:9000/ecommerce-media

# ---- Security ----
# Browser origins of the web storefront and admin dashboard (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@your-shop.com
ADMIN_PASSWORD=Change-Me-Admin@123
PASSWORD_RESET_URL=http://localhost:3000/reset-password

# ---- Store ----
APP_TIMEZONE=Asia/Phnom_Penh
SHOP_CURRENCY=USD
SHOP_SHIPPING_FEE=2.00
SHOP_FREE_SHIPPING_THRESHOLD=50.00

# ---- API docs ----
SWAGGER_ENABLED=true
